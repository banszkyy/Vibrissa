using Primitives;
using System.String;
using System.Memory;
using System.List;
using System.Math;

export void clear()
{
    print("\e[2J");
    print("\e[H");
}

export void printf(char[] format, any[] args)
{
    int l = format.length();
    any* offset = (&format + l + 1) as any*;
    for (int i = 0; format[i]; i++)
    {
        if (format[i] == '%')
        {
            i++;
            if (format[i] == 'd')
            {
                print(*(offset as int*));
                offset += sizeof(int);
            }
            else if (format[i] == 'f')
            {
                print(*(offset as float*));
                offset += sizeof(float);
            }
            else if (format[i] == 's')
            {
                print(*(offset as string*));
                offset += sizeof(string);
            }
            else
            {
                print('%');
                print(format[i]);
            }
        }
        else
        {
            print(format[i]);
        }
    }
}

export void printf(temp string format, any[] args)
{
    int offset = &args as int;
    for (int i = 0; format[i]; i++)
    {
        if (format[i] == '%')
        {
            i++;
            if (format[i] == 'd')
            {
                print(*(offset as int*));
                offset += sizeof(int);
            }
            else if (format[i] == 'f')
            {
                print(*(offset as float*));
                offset += sizeof(float);
            }
            else if (format[i] == 's')
            {
                print(*(offset as string*));
                offset += sizeof(string);
            }
            else
            {
                print('%');
                print(format[i]);
            }
        }
        else
        {
            print(format[i]);
        }
    }
}

[External("stdout")]
export void print(char message);

/*
 * Source: https://copyprogramming.com/howto/print-an-int-in-c-without-printf-or-any-functions
 */
u8 find_max_pow_of_10(u8 num)
{
    u8 result = (u8)1;
    num /= (u8)10;
    while (num)
    {
        result *= (u8)10;
        num /= (u8)10;
    }
    return result;
}

